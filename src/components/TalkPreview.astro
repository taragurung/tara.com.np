---
import { type CollectionEntry } from 'astro:content';
import ArrowRight from '../icons/ArrowRight.astro';
import FormattedDate from './FormattedDate.astro';

type Props = { talk: CollectionEntry<'talks'>; class?: string; headingLevel?: 'h2' | 'h3' };

const { talk, class: className, headingLevel = 'h3' } = Astro.props;
const { title, event, date, link, image, description, location } = talk.data;
const isUpcoming = date.getTime() >= new Date().setHours(0, 0, 0, 0);
const TitleTag = headingLevel;
---

<div
    class:list={[
        'flex flex-col overflow-hidden rounded-xl border border-main/10 bg-muted/40 shadow-sm transition-all hover:border-accent/30 hover:shadow-md',
        className
    ]}
>
    {
        image && (
            <div class="aspect-video w-full overflow-hidden">
                <img src={image.src} alt={image.alt ?? title} class="h-full w-full object-cover" loading="lazy" />
            </div>
        )
    }
    <div class="flex grow flex-col p-5 sm:p-6">
        <div class="mb-2 flex items-center justify-between gap-2">
            <span class="text-xs font-semibold tracking-wide text-accent uppercase">{event}</span>
            {isUpcoming && <span class="shrink-0 rounded-full bg-accent px-2.5 py-0.5 text-xs font-medium text-accent-foreground">Upcoming</span>}
        </div>
        <TitleTag class="text-lg leading-tight font-serif font-medium sm:text-xl">{title}</TitleTag>
        <div class="mt-1 text-sm leading-normal opacity-70">
            <FormattedDate date={date} />
            {location && <span> · {location}</span>}
        </div>
        {description && <p class="mt-3 text-sm leading-normal opacity-80">{description}</p>}
        <div class="mt-4 grow" />
        {
            link ? (
                <a
                    href={link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 self-start text-sm font-medium text-accent transition hover:underline"
                >
                    View Talk <ArrowRight class="h-4 w-4 fill-current" />
                </a>
            ) : (
                isUpcoming && <span class="text-sm opacity-60">Details coming soon</span>
            )
        }
    </div>
</div>
