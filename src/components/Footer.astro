---
import siteConfig from '../data/site-config';

const socialLinks = siteConfig.socialLinks || [];
const navLinks = siteConfig.footerNavLinks || [];
---

<footer class="w-full max-w-6xl mx-auto mt-24 pt-10 pb-10 border-t border-main sm:mt-32 sm:pb-14">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
        <div>
            <a href="/" class="inline-flex items-center gap-2 font-mono font-semibold">
                <img src="/tara-gurung-avatar.png" alt="" width="32" height="32" class="h-8 w-8 rounded-full object-cover ring-2 ring-accent/60" />
                {siteConfig.title.toLowerCase().replace(/\s+/g, '')}
            </a>
            {siteConfig.subtitle && <p class="mt-2 text-sm text-muted">{siteConfig.subtitle}</p>}
        </div>
        <div class="flex flex-wrap gap-x-10 gap-y-6">
            {
                navLinks.length > 0 && (
                    <div class="flex flex-col gap-2">
                        <span class="font-mono text-xs uppercase tracking-wider text-muted">Site</span>
                        {navLinks.map((link) => (
                            <a class="text-sm transition hover:text-accent" href={link.href}>
                                {link.text}
                            </a>
                        ))}
                    </div>
                )
            }
            {
                socialLinks.length > 0 && (
                    <div class="flex flex-col gap-2">
                        <span class="font-mono text-xs uppercase tracking-wider text-muted">Connect</span>
                        {socialLinks.map((link) => (
                            <a class="text-sm transition hover:text-accent" href={link.href} target="_blank" rel="noopener noreferrer">
                                {link.text}
                            </a>
                        ))}
                    </div>
                )
            }
        </div>
    </div>
    <p class="mt-10 text-xs text-muted">
        &copy; {new Date().getFullYear()}&nbsp;<a class="hover:text-accent" href="/">{siteConfig.title}</a>. All rights reserved.
    </p>
</footer>
