---
import { type CollectionEntry } from 'astro:content';
import ArrowRight from '../icons/ArrowRight.astro';
import FormattedDate from './FormattedDate.astro';

type Props = { post: CollectionEntry<'blog'>; class?: string; headingLevel?: 'h2' | 'h3' };

const { post, class: className, headingLevel = 'h3' } = Astro.props;
const { title, publishDate, excerpt, seo, tags } = post.data;
const image = seo?.image;
const TitleTag = headingLevel;
---

<a
    href={`/blog/${post.slug}/`}
    class:list={[
        'group flex flex-col overflow-hidden rounded-xl border border-main/10 bg-muted/40 shadow-sm transition-all hover:border-accent/30 hover:shadow-md',
        className
    ]}
>
    {
        image && (
            <div class="aspect-video w-full overflow-hidden">
                <img src={image.src} alt={image.alt ?? title} class="h-full w-full object-cover" loading="lazy" />
            </div>
        )
    }
    <div class="flex grow flex-col p-5 sm:p-6">
        {tags && tags.length > 0 && <div class="mb-2 text-xs font-semibold tracking-wide text-accent uppercase">{tags[0]}</div>}
        <TitleTag class="text-lg leading-tight font-serif font-medium transition group-hover:text-accent sm:text-xl">{title}</TitleTag>
        <div class="mt-1 text-sm leading-normal opacity-70">
            <FormattedDate date={publishDate} />
        </div>
        {excerpt && <p class="mt-3 line-clamp-3 text-sm leading-normal opacity-80">{excerpt}</p>}
        <div class="mt-4 grow" />
        <div class="inline-flex items-center gap-1 self-start text-sm font-medium text-accent">
            Read Post <ArrowRight class="h-4 w-4 fill-current transition group-hover:translate-x-0.5" />
        </div>
    </div>
</a>
