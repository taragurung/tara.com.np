---
import Button from './Button.astro';
import siteConfig from '../data/site-config';

const cta = siteConfig.cta;
---

{
    cta && (
        <section class="py-16 sm:py-24">
            <div class="relative overflow-hidden rounded-2xl border border-main bg-muted px-6 py-14 text-center sm:px-16 sm:py-20">
                <div class="relative mx-auto max-w-2xl">
                    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{cta.title}</h2>
                    {cta.text && <p class="mt-4 text-lg text-muted">{cta.text}</p>}
                    {cta.actions && cta.actions.length > 0 && (
                        <div class="mt-8 flex flex-wrap justify-center gap-3">
                            {cta.actions.map((action, index) => (
                                <Button
                                    href={action.href}
                                    variant={index === 0 ? 'primary' : 'secondary'}
                                    {...(action.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                                >
                                    {action.text}
                                </Button>
                            ))}
                        </div>
                    )}
                </div>
            </div>
        </section>
    )
}
