---
import siteConfig from '../data/site-config';
---

<header class="w-full max-w-3xl mx-auto pt-12 sm:pt-16">
    {
        siteConfig.logo && siteConfig.logo?.src ? (
            <a href="/">
                <img src={siteConfig.logo.src} alt={siteConfig.logo.alt || ''} class="max-h-12" />
            </a>
        ) : (
            <a class="text-2xl leading-tight font-bold tracking-tight sm:text-4xl" href="/">
                {siteConfig.title}
            </a>
        )
    }
    {siteConfig.subtitle && <p class="mt-2 font-mono text-sm text-accent">{siteConfig.subtitle}</p>}
</header>
