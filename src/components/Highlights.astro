---
import SectionHeading from './SectionHeading.astro';
import siteConfig from '../data/site-config';

const highlights = siteConfig.highlights || [];
---

{
    highlights.length > 0 && (
        <section class="py-16 sm:py-24">
            <SectionHeading eyebrow="// beyond the code" title="Speaking & Community" />
            <div class="grid gap-6 md:grid-cols-2">
                {highlights.map((item) => (
                    <div class="group flex flex-col overflow-hidden rounded-2xl border border-main bg-muted/50 transition hover:border-accent/50">
                        <div class="relative aspect-[16/9] overflow-hidden border-b border-main">
                            {item.image?.src ? (
                                <img
                                    src={item.image.src}
                                    alt={item.image.alt || ''}
                                    loading="lazy"
                                    decoding="async"
                                    class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                                />
                            ) : (
                                <div class="relative flex h-full w-full items-center justify-center bg-muted">
                                    <span class="relative px-6 text-center text-3xl font-extrabold tracking-tight sm:text-4xl">
                                        {item.title.startsWith('TEDx') ? (
                                            <>
                                                <span class="text-red-600">TEDx</span>
                                                <span class="font-light">{item.title.slice(4)}</span>
                                            </>
                                        ) : (
                                            item.title
                                        )}
                                    </span>
                                </div>
                            )}
                        </div>
                        <div class="flex grow flex-col p-6 sm:p-8">
                            <span class="mb-3 font-mono text-xs uppercase tracking-wider text-accent">{item.label}</span>
                            <h3 class="text-xl font-bold tracking-tight sm:text-2xl">{item.title}</h3>
                            <p class="mt-3 leading-relaxed text-muted">{item.text}</p>
                            <div class="mt-auto pt-6 text-sm font-semibold">
                                {item.link ? (
                                    <a href={item.link.href} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">
                                        {item.link.text} ↗
                                    </a>
                                ) : (
                                    item.note && (
                                        <span class="inline-flex items-center gap-2 text-muted">
                                            <span class="h-2 w-2 animate-pulse rounded-full bg-red-500" />
                                            {item.note}
                                        </span>
                                    )
                                )}
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </section>
    )
}
