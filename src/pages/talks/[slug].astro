---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TalkPreview from '../../components/TalkPreview.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { sortTalksByDateDesc } from '../../utils/data-utils';

export async function getStaticPaths() {
    const talks = (await getCollection('talks')).sort(sortTalksByDateDesc);
    const talkCount = talks.length;
    return talks.map((talk, index) => ({
        params: { slug: talk.slug },
        props: {
            talk,
            prevTalk: index + 1 !== talkCount ? talks[index + 1] : null,
            nextTalk: index !== 0 ? talks[index - 1] : null
        }
    }));
}

type Props = { talk: CollectionEntry<'talks'>; prevTalk: CollectionEntry<'talks'> | null; nextTalk: CollectionEntry<'talks'> | null };

const { talk, prevTalk, nextTalk } = Astro.props;
const { title, event, date, link, image, location, seo } = talk.data;
const { Content } = await talk.render();
---

<BaseLayout title={seo?.title ?? title} description={seo?.description} image={seo?.image ?? image} pageType="article" showHeader={false}>
    <article class="mb-16 sm:mb-24">
        <header class="mb-8">
            <div class="mb-2 font-serif text-sm">{event}</div>
            <h1 class="text-3xl leading-tight font-serif font-medium sm:text-5xl sm:leading-tight">{title}</h1>
            <div class="mt-3 text-sm leading-normal opacity-70">
                <FormattedDate date={date} />
                {location && <span> · {location}</span>}
            </div>
        </header>
        {
            image && (
                <div class="mb-8 aspect-video w-full overflow-hidden rounded-xl border border-main/10">
                    <img src={image.src} alt={image.alt ?? title} class="h-full w-full object-cover" />
                </div>
            )
        }
        <div class="max-w-none prose prose-dante sm:prose-lg">
            <Content />
        </div>
        {
            link && (
                <a
                    href={link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-8 inline-flex items-center gap-1 text-sm font-medium text-accent underline underline-offset-4"
                >
                    View event page →
                </a>
            )
        }
    </article>
    {
        (prevTalk || nextTalk) && (
            <div class="my-16 sm:my-24">
                <h2 class="mb-12 text-xl font-serif font-medium sm:mb-16 sm:text-2xl">More Talks</h2>
                <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                    {nextTalk && <TalkPreview talk={nextTalk} headingLevel="h3" />}
                    {prevTalk && <TalkPreview talk={prevTalk} headingLevel="h3" />}
                </div>
            </div>
        )
    }
</BaseLayout>
